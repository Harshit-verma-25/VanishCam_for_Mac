{
  "manifest_version": 3,
  "name": "Vanish Camera for Google Meet",
  "version": "1.1",
  "description": "Adds Vanish Camera to Google Meet's camera list. Video comes from the VanishCam Local app on this Mac.",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
